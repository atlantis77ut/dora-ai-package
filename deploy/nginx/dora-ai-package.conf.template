# DORA AI Ajan Paketi — nginx TLS sitesi (şablon)
# Kaynak: deploy/nginx/dora-ai-package.conf.template
# Kurulum: sudo node scripts/install-tls.mjs --domain dora.ornek.local --email admin@ornek.local
#
# Yer tutucular (install-tls.mjs doldurur):
#   DOMAIN        genel alan adı
#   BACKEND_PORT  uygulamanın yerel portu (127.0.0.1)
#   CERT_DIR      sertifika dizini (fullchain.pem / privkey.pem)
#   CHAIN_FILE    ara sertifika zinciri (chain.pem; yoksa fullchain.pem)
#   ACME_ROOT     ACME webroot dizini (/.well-known/acme-challenge)
#
# Not: HSTS burada DEĞİL uygulamada verilir (bkz. server.mjs isHttps). Çift
# başlık tarayıcıda yok sayılır; tek kaynak uygulama kalsın.

# ── 80: yalnız ACME doğrulaması ve HTTPS'e yönlendirme ──────────────────
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root __ACME_ROOT__;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── 443: TLS sonlandırma + ters vekil ───────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    ssl_trusted_certificate __CHAIN_FILE__;

    ssl_protocols TLSv1.2 TLSv1.3;
    # Mozilla "intermediate" kümesi (TLS 1.2 için; TLS 1.3 kümeleri OpenSSL'de sabittir)
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:dora_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;

    # CSV yükleme uygulamada 5 MB ile sınırlı; vekilde biraz pay bırakılır.
    client_max_body_size 12m;
    client_body_timeout 30s;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    access_log /var/log/nginx/dora-access.log;
    error_log  /var/log/nginx/dora-error.log warn;

    # Giriş denemeleri için IP başına hız sınırı (zone: conf.d/dora-ratelimit.conf)
    location ^~ /api/auth/ {
        limit_req zone=dora_auth burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/dora-proxy.conf;
    }

    # Sağlık uç noktası: gürültü yapmasın
    location = /healthz {
        access_log off;
        include /etc/nginx/snippets/dora-proxy.conf;
    }

    location / {
        include /etc/nginx/snippets/dora-proxy.conf;
    }
}
