[Unit]
Description=DORA AI Ajan Paketi — uygulama ve statik dashboard sunucusu
Documentation=file:///opt/dora-ai-package/docs/KURULUM-UBUNTU.md
Documentation=file:///opt/dora-ai-package/docs/URETIM-TLS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dora
Group=dora
WorkingDirectory=/opt/dora-ai-package
# /etc/dora/dora.env varsa okunur (SMTP, SIEM, DORA_DATA_DIR gibi ayarlar için).
# Dosya 0600 ve root:dora sahipliğinde olmalı; sırlar unit içine yazılmaz.
EnvironmentFile=-/etc/dora/dora.env
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/dora-ai-package/onboarding/cli/tools/server.mjs --port ${PORT} --host ${HOST}
Restart=always
RestartSec=3
# Kullanıcı verisi (web-data/) dünya tarafından okunamasın
UMask=0077
TimeoutStopSec=15

# Sertleştirme: paket yalnızca dosya okur, ağ dinler.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ReadOnlyPaths=/opt/dora-ai-package
# uygulama verisi yazılabilir olmalı
ReadWritePaths=/opt/dora-ai-package/web-data /opt/dora-ai-package/.dora-onboarding
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# PDF üretimi ve büyük CSV içe aktarımı için pay bırakıldı
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
