{
  "title": "Sentetik kabul senaryosu",
  "type": "object",
  "required": [
    "scenario",
    "given",
    "when",
    "then",
    "negative_tests",
    "timeline",
    "evidence_expected"
  ],
  "properties": {
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "version",
        "name",
        "purpose",
        "processes_exercised",
        "controls_checked",
        "assertions_total"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SCN-\\d{2}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "name": {
          "type": "object",
          "required": [
            "tr",
            "en"
          ],
          "properties": {
            "tr": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          }
        },
        "purpose": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "tier_scope": {
          "type": "array",
          "items": {
            "enum": [
              "tier1",
              "tier2",
              "tier3"
            ]
          }
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "assertions_total": {
          "type": "integer",
          "minimum": 1
        },
        "pass_threshold": {
          "type": "string"
        },
        "processes_exercised": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^PRC-"
          }
        },
        "controls_checked": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CTL-"
          }
        },
        "roles_exercised": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ROL-"
          }
        }
      },
      "description": "Senaryo başlığı: kimlik, kapsam, assertion sayısı"
    },
    "given": {
      "type": "object"
    },
    "when": {
      "type": "object",
      "required": [
        "trigger"
      ],
      "properties": {
        "trigger": {
          "type": "string"
        },
        "agent_autonomy": {
          "enum": [
            "observe",
            "recommend",
            "act_with_approval",
            "act_autonomous"
          ]
        },
        "human_in_loop": {
          "type": "boolean"
        }
      }
    },
    "then": {
      "type": "object",
      "required": [
        "assertions"
      ],
      "properties": {
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement",
              "expected",
              "process",
              "fail_if"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^A\\d+$"
              },
              "statement": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "process": {
                "type": "string",
                "pattern": "^PRC-"
              },
              "control": {
                "type": "string",
                "pattern": "^CTL-"
              },
              "deadline_days": {
                "type": "integer",
                "minimum": 0
              },
              "deadline_minutes": {
                "type": "integer",
                "minimum": 0
              },
              "fail_if": {
                "type": "string"
              },
              "matched_criterion": {
                "type": "string"
              },
              "deadline_hours": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "negative_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "trap",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^N\\d+$"
          },
          "trap": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "event"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "process": {
            "type": "string"
          }
        }
      }
    },
    "evidence_expected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
