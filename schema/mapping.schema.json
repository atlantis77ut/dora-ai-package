{
  "title": "DORA madde eşlemesi",
  "type": "object",
  "required": [
    "mapping",
    "articles"
  ],
  "properties": {
    "mapping": {
      "type": "object",
      "required": [
        "version",
        "generated_at",
        "source"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "generated_at": {
          "type": "string",
          "minLength": 10
        },
        "source": {
          "type": "string"
        },
        "scope_note": {
          "type": "string"
        }
      }
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "chapter",
          "title",
          "obligations",
          "processes",
          "controls",
          "roles",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Art-\\d{2}$"
          },
          "chapter": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "processes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^PRC-[A-Z]{3}-\\d{2}$"
            }
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CTL-[A-Z]{3}-\\d{3}$"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "covered",
              "partial",
              "gap"
            ]
          },
          "note": {
            "type": "string"
          },
          "tier_note": {
            "type": "string"
          }
        }
      }
    }
  }
}
