{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dora-package.org/schema/common.schema.json",
  "title": "DORA Ortak Tipler",
  "$defs": {
    "Version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["1.0.0", "2.3.1"]
    },
    "DoraReference": {
      "type": "object",
      "anyOf": [{ "required": ["article"] }, { "required": ["rts_its"] }],
      "description": "En az bir referans zorunlu: article veya rts_its. Bazı karar kuralları yalnızca RTS maddesine dayanır.",
      "properties": {
        "article": { "type": "string", "examples": ["Madde 5", "Article 18"] },
        "paragraph": { "type": "string", "examples": ["1(a)", "3"] },
        "rts_its": { "type": "string", "examples": ["RTS 2024/1774"] },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "Tier": {
      "type": "string",
      "enum": ["tier1", "tier2", "tier3"],
      "description": "tier1=büyük/sistemik, tier2=orta, tier3=küçük/kamu"
    },
    "DefenceLine": {
      "type": ["integer", "null"],
      "enum": [1, 2, 3, null],
      "description": "1=operasyon, 2=kontrol, 3=denetim, null=yönetim organı (hat dışı)"
    },
    "SLA": {
      "type": "object",
      "required": ["trigger", "duration", "unit"],
      "properties": {
        "trigger": { "type": "string" },
        "duration": { "type": "number" },
        "unit": { "type": "string", "enum": ["minutes", "hours", "days", "months"] },
        "clock_start": { "type": "string", "enum": ["detection", "classification", "approval"] }
      }
    },
    "Regulator": {
      "type": "string",
      "examples": ["BDDK", "TCMB", "EBA", "ESMA", "EIOPA", "FCA", "BaFin"]
    },
    "I18nText": {
      "type": "object",
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string" },
        "en": { "type": "string" }
      }
    }
  }
}
